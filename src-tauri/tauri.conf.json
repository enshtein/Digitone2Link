{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digitone2Link",
  "version": "0.1.2",
  "identifier": "com.enshtein.digitone2link",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Digitone2Link", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 620 }], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "release-icons/32x32.png",
      "release-icons/128x128.png",
      "release-icons/128x128@2x.png",
      "release-icons/icon.icns",
      "release-icons/icon.ico"
    ]
  }
}
